# --- API ---
RAGHIVE_HOST=0.0.0.0
RAGHIVE_PORT=8000
RAGHIVE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# lite = run without GLiNER / Qwen-0.5B / GPU (heuristic + embedding fallbacks)
# full = fail loudly if GLiNER cannot load (thesis / A100 cluster)
RAGHIVE_MODE=lite

# --- LLM (vLLM OpenAI-compatible, or any OpenAI-compatible server) ---
# FastAPI occupies :8000 — point vLLM at a different port (e.g. 8001).
LOCAL_INFERENCE_URL=http://localhost:8001/v1
LOCAL_API_KEY=LOCAL_API_KEY
GEN_MODEL_NAME=Qwen/Qwen2.5-32B-Instruct
XAI_MODEL_NAME=Qwen/Qwen2.5-0.5B-Instruct

# If vLLM is unreachable, the pipeline still runs using heuristic plan/answer
# generators so the frontend can be wired without a GPU box.
RAGHIVE_ALLOW_HEURISTIC_LLM=true

# --- Embeddings / retrieval ---
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
CHROMA_PATH=./data/chroma
CHROMA_COLLECTION=raghive_chunks
SEED_ON_STARTUP=true

# --- Auth ---
# true = accept any Bearer token (and the frontend mock token) as the demo user
AUTH_DISABLED=true
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_FILE=
MOCK_BEARER_TOKEN=mock_firebase_id_token_raghive_bearer_12345

# --- Persistence ---
DATABASE_URL=sqlite:///./data/raghive.db
UPLOAD_DIR=./data/uploads
