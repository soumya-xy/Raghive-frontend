# ==============================================================================
# RAGHive Monorepo Git Ignore
# Covers root, frontend/ (Next.js), and backend/ (FastAPI / Python)
# ==============================================================================

# ------------------------------------------------------------------------------
# Environment Variables & Secrets
# ------------------------------------------------------------------------------
.env
.env*.local
.env.production
.env.development
.env.test
backend/.env
frontend/.env*.local
*.pem
*.key

# Preserve example environment templates
!.env.example
!frontend/.env.example
!backend/.env.example

# ------------------------------------------------------------------------------
# Frontend (Next.js / Node / TypeScript)
# ------------------------------------------------------------------------------
node_modules/
frontend/node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js build outputs
.next/
frontend/.next/
out/
frontend/out/
build/
frontend/build/
dist/

# Testing & Coverage
coverage/
frontend/coverage/

# TypeScript cache
*.tsbuildinfo
next-env.d.ts
frontend/next-env.d.ts

# Vercel deployment
.vercel/

# Package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ------------------------------------------------------------------------------
# Backend (Python / FastAPI / LangGraph / Vector DB)
# ------------------------------------------------------------------------------
# Virtual environments
.venv/
venv/
ENV/
backend/.venv/
backend/venv/

# Byte-compiled / cache files
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.installed.cfg
*.egg

# Testing & Type checking caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local databases, vectors, and uploads
backend/data/*.db
backend/data/*.db-journal
backend/data/chroma/
backend/data/uploads/
data/*.db
data/*.db-journal
data/chroma/
data/uploads/
!backend/data/.gitkeep

# Model weights & HuggingFace caches
hf_cache/
/models/
backend/hf_cache/
backend/models/
!backend/app/models/
!app/models/

# Logs
*.log

# ------------------------------------------------------------------------------
# OS & IDE Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
.idea/
.vscode/
*.swp
*.swo
